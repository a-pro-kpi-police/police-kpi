POSTGRES_DB=kpi
POSTGRES_USER=kpi
POSTGRES_PASSWORD=replace_with_32_hex_chars

KPI_SECRET=replace_with_long_random_secret
KPI_HEAD_PASSWORD=replace_with_strong_head_password
KPI_IMPORT_DEFAULT_PASSWORD=replace_with_temporary_officer_password

KPI_DEBUG=0
KPI_SEED_MODE=monthly_import

# Keep the app private behind host Nginx and Let's Encrypt.
APP_BIND=127.0.0.1:8080

# For a quick HTTP-only smoke test without host Nginx, temporarily use:
# APP_BIND=0.0.0.0:80
